rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙 에 전체를 붙여 넣고 [게시]하세요.
// 최고 관리자: 아래 ADMIN_EMAIL@gmail.com 한 곳만 본인 구글 계정으로 되어 있습니다(제거 불가).
//   - 업무카드는 로그인하지 않아도 누구나 읽을 수 있습니다(보기 전용).
//   - 수정·추가·삭제는 편집 권한(access)이 있는 계정 또는 관리자만 가능합니다.
//   access/{이메일}   = {role: 'edit'}   편집 권한
//   admins/{이메일}   = 관리자(권한 관리 + 모든 카드 편집)
//   requests/{이메일} = 편집 권한 요청(본인만 작성, 관리자가 승인/거절)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function isSuper() { return signedIn() && me() == 'ADMIN_EMAIL@gmail.com'; }
    function isAdmin() { return isSuper() || (signedIn() && exists(/databases/$(database)/documents/admins/$(me()))); }
    function canEdit() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/access/$(me())) && get(/databases/$(database)/documents/access/$(me())).data.role == 'edit'); }

    match /cards/{id} {
      allow read: if true;
      allow create, update: if canEdit() && request.resource.data.json.size() < 900000;
      allow delete: if canEdit();
    }
    match /meta/{id}   { allow read: if true; allow write: if canEdit(); }
    match /events/{id} { allow read: if true; allow write: if canEdit(); }
    match /blobs/{id} {
      allow read: if true;
      allow create, update: if canEdit() && request.resource.data.b64.size() < 950000;
      allow delete: if canEdit();
    }

    // 편집 권한 부여 목록
    match /access/{email} {
      allow get: if isAdmin() || (signedIn() && me() == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower() && request.resource.data.role == 'edit';
      allow delete: if isAdmin();
    }
    // 관리자 목록(최고 관리자는 여기에 없어도 항상 관리자이며 제거 불가)
    match /admins/{email} {
      allow get: if isAdmin() || (signedIn() && me() == email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && email == email.lower() && email != 'ADMIN_EMAIL@gmail.com';
    }
    // 편집 권한 요청: 로그인한 본인이 자기 이메일로만 작성, 관리자가 목록 확인·삭제
    match /requests/{email} {
      allow get: if isAdmin() || (signedIn() && me() == email);
      allow list: if isAdmin();
      allow create, update: if signedIn() && me() == email && request.resource.data.email == email;
      allow delete: if isAdmin() || (signedIn() && me() == email);
    }
  }
}
